# Fleet24 Customer App Staging Environment Configuration
# Copy to .env in customer-app when generating staging builds:
EXPO_PUBLIC_API_URL=https://api-staging.fleet24.com/api/v1
EXPO_PUBLIC_SOCKET_URL=https://api-staging.fleet24.com


# Google Maps browser/app key for the address map (Maps JavaScript API on web,
# Maps SDK for Android in native builds). Restrict it by HTTP referrer / Android app.
# Place search and address lookup use the backend's server key, not this one.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
