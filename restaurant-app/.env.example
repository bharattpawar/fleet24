# Fleet24 Restaurant Partner Mobile Application Environment Configuration
# Copy this file to .env or .env.local for local overrides.

# Remote / Staging API Base URL (Takes precedence over automatic fallbacks)
# Example: https://api.staging.fleet24.in/api/v1
# Leave unset in development to use the Metro host or localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Remote / Staging Socket.IO URL
# Example: https://api.staging.fleet24.in
# If unset, sockets use the API origin.
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000


# Immediately verify the development OTP after requesting it. Requires backend dev bypass.
EXPO_PUBLIC_DEV_AUTH_BYPASS=false
