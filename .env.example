# ==============================================================================
# Fleet24 Database Docker Environment Configuration
# ==============================================================================
# Copy this file to .env before running:
#   docker compose -p fleet24 up -d
#
# DO NOT COMMIT THE ACTUAL .env FILE OR EXPOSE SECRETS IN REPOSITORIES.
# ==============================================================================

# Database Name
POSTGRES_DB=fleet24_dev

# Database User
POSTGRES_USER=fleet24_user

# Database Password (Change this to a strong password in your local .env)
POSTGRES_PASSWORD=fleet24_local_dev_password

# Host Port Mapped to Container Port 5432
# Defaulted to 5434 to prevent conflicts with default PostgreSQL (5432)
# and existing project containers (5433).
POSTGRES_PORT=5434
