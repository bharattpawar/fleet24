# ==============================================================================
# Fleet24 Backend Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the backend application:
#   cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL .env FILE OR EXPOSE SECRETS IN REPOSITORIES.
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
# Always set this explicitly. In production the server refuses to start unless
# JWT_ACCESS_SECRET, RAZORPAY_WEBHOOK_SECRET,
# CORS_ORIGINS and GOOGLE_CLIENT_IDS are all set.
NODE_ENV=development

# Development-only login shortcuts: OTP 123456 / 000000 and the mock Google token.
# Honoured only when NODE_ENV=development. Never set this in production.
ALLOW_DEV_AUTH_BYPASS=true

# Application Port
PORT=4000

# PostgreSQL Database Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=<mode>
# Port 5434 corresponds to the dedicated Fleet24 docker container mapped port
DATABASE_URL=postgresql://fleet24_user:fleet24_local_dev_password@localhost:5434/fleet24_dev

# Allowed CORS Origins (comma-separated list for multiple origins)
# For web admin dashboards and local testing. Note: Mobile apps (React Native / Expo)
# do not enforce browser CORS restrictions, but requests can still supply origin headers.
# Example: http://localhost:3000,http://localhost:8081
# Comma-separated HTTP(S) origins. Development also permits private-network and loopback origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# JWT Authentication Configuration
# Required in production (min 32 chars). Generate with: openssl rand -hex 32
# If unset in development, a per-installation secret is derived from DATABASE_URL.
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# OTP Security Configuration
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMS Provider ('mock' for development/testing, or future 'twilio' / 'msg91')
SMS_PROVIDER=mock

# Google OAuth Configuration (for Google Sign-In)
# Comma-separated list of every Fleet24 OAuth client ID (web, iOS, Android).
# Only ID tokens issued to these clients are accepted. Required in production.
# Current clients: customer app (840348382677-...) and admin dashboard (78207612821-...).
GOOGLE_CLIENT_IDS=840348382677-6loj3nm3cmkhafhdfs2ejlho1ibbquph.apps.googleusercontent.com,78207612821-98vq0vi6pf1tt71cc1k4u4jae75jfbna.apps.googleusercontent.com
# Legacy single client ID (still accepted, merged into GOOGLE_CLIENT_IDS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Payment Gateway Configuration (Test Mode)
# Obtain test credentials from Razorpay Dashboard (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Payment checkout return URLs (comma-separated). The fleet24:// app scheme is always allowed.
# Add https origins for any web client, e.g. https://app.fleet24.in
# Outside production, Expo (exp://) and localhost return URLs are also accepted.
PAYMENT_RETURN_URL_ALLOWLIST=

# Google Routes API Configuration (Authoritative Road-Distance Routing)
# Restrict the key to Google Routes API in Google Cloud Console.
# Never expose this key in frontend code, git commits, or client responses.
GOOGLE_ROUTES_API_KEY=
# Optional separate server key for place search / reverse geocoding (address picker,
# service areas). Falls back to GOOGLE_ROUTES_API_KEY. Needs Places API (New) + Geocoding API.
GOOGLE_MAPS_API_KEY=
ROUTING_PROVIDER=google
ROUTING_TIMEOUT_MS=3000
ROUTING_CACHE_TTL_SECONDS=3600
ROUTING_CACHE_MAX_ENTRIES=2000



